# ─── Gemini (Execution / Planner Agent) ───────────────────────────────────
GOOGLE_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-2.0-flash

# ─── Paranoid Gatekeeper (OpenAI-compatible / vLLM) ────────────────────────
# Point at NeevCloud, local vLLM, LM Studio, or OpenAI
PARANOID_BASE_URL=http://localhost:8000/v1
PARANOID_API_KEY=not-needed-for-local-vllm
PARANOID_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Optional fallback when the custom endpoint is unreachable
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ─── EVM Execution Layer ───────────────────────────────────────────────────
# Leave PRIVATE_KEY empty for dry-run / mock tx hashes
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
PRIVATE_KEY=
FROM_ADDRESS=

# ─── RAG / Chroma ──────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./backend/rag/.chroma
CHROMA_COLLECTION=aegis_security_specs

# ─── Demo mode: deterministic offline proposals/audits when keys are missing
DEMO_MODE=true

# ─── API ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=*
