# ─── Gemini (dual-agent — one API key) ─────────────────────────────────────
GOOGLE_API_KEY=your_google_ai_studio_api_key

# Agent 1 — Execution / Planner (fast structured calldata)
GEMINI_MODEL=gemini-3.6-flash

# Agent 2 — Paranoid Gatekeeper (default: Pro)
GEMINI_PARANOID_MODEL=gemini-3.1-pro-preview

# Agent 2 — Fast audit toggle in UI (Flash)
GEMINI_PARANOID_FAST_MODEL=gemini-3.7-flash

# ─── Optional: OpenAI-compatible vLLM (NeevCloud) — off by default ─────────
PARANOID_USE_VLLM=false
PARANOID_BASE_URL=http://localhost:8000/v1
PARANOID_API_KEY=not-needed-for-local-vllm
PARANOID_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Optional fallback when vLLM is enabled but unreachable
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ─── EVM Execution Layer ───────────────────────────────────────────────────
# Leave PRIVATE_KEY empty for dry-run / mock tx hashes
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
PRIVATE_KEY=
FROM_ADDRESS=

# ─── RAG / Chroma ──────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./backend/rag/.chroma
CHROMA_COLLECTION=aegis_security_specs

# Set false when GOOGLE_API_KEY is configured for live dual-Gemini demo
DEMO_MODE=false

# ─── API ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
# Production: comma-separated UI origins, e.g. https://aegis-agent.pages.dev
CORS_ORIGINS=*
