# Production .env for NeevCloud VM — copy to /opt/aegis-agent/.env
# chmod 600 && chown aegis:aegis

# ─── Gemini (required for live demo) ───────────────────────────────────────
GOOGLE_API_KEY=

GEMINI_MODEL=gemini-3.6-flash
GEMINI_PARANOID_MODEL=gemini-3.1-pro-preview
GEMINI_PARANOID_FAST_MODEL=gemini-3.6-flash

# ─── vLLM on NeevCloud GPU — leave off; API uses Gemini ─────────────────────
PARANOID_USE_VLLM=false

# ─── EVM (optional — mock tx hash if PRIVATE_KEY empty) ──────────────────────
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
PRIVATE_KEY=
FROM_ADDRESS=

# ─── RAG ─────────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=/opt/aegis-agent/backend/rag/.chroma
CHROMA_COLLECTION=aegis_security_specs

# ─── Runtime ─────────────────────────────────────────────────────────────────
DEMO_MODE=false

# Comma-separated Pages / custom UI origins (no trailing slashes)
# Example: https://aegis-agent.pages.dev,https://aegis.yourdomain.com
CORS_ORIGINS=https://aegis-agent.pages.dev

API_HOST=0.0.0.0
API_PORT=8080
